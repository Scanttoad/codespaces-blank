<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Emulador de Enigma</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#111923;color:#eef3f7;font:16px/1.5 system-ui,sans-serif}main{max-width:850px;margin:30px auto;padding:0 16px}.card{background:#1c2936;border:1px solid #3b4b5b;border-radius:12px;padding:20px;margin:16px 0}h1{margin-top:0}h2{color:#f2bd62;font-size:1.2rem}.muted{color:#bdc8d2}.rotors{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.rotor{padding:12px;border:1px solid #3b4b5b;border-radius:8px}label{display:block;margin:9px 0 4px;font-weight:600}select,input,textarea,button{font:inherit;color:inherit;background:#111923;border:1px solid #485a6b;border-radius:6px;padding:9px;width:100%}button{width:auto;background:#f2bd62;color:#211b10;border:0;font-weight:bold;cursor:pointer}.actions{display:flex;gap:10px;margin-top:14px;flex-wrap:wrap}#result{min-height:48px;padding:12px;background:#111923;border-radius:6px;overflow-wrap:anywhere;font:700 1.1rem ui-monospace,monospace;letter-spacing:.08em}.config-card{margin:12px 0;padding:14px 16px;border:1px solid #886c3e;border-radius:9px;background:linear-gradient(135deg,#30291e,#1b2630);box-shadow:inset 3px 0 #f2bd62}.config-card strong{display:block;margin-bottom:4px;color:#f2bd62;letter-spacing:.04em}.config-card p{margin:0;color:#e0e7ed;overflow-wrap:anywhere}code{color:#f2bd62}@media(max-width:560px){.rotors{grid-template-columns:1fr}}
</style></head>
<body><main>
<header class="card"><h1>Emulador de la máquina Enigma</h1><p class="muted">Simulación educativa de Enigma I. Configura los rotores y cifra o descifra un texto.</p></header>
<section class="card"><h2>Configuración</h2><div class="rotors" id="rotors"></div>
<label for="reflector">Reflector</label><select id="reflector"><option value="B">B</option><option value="C">C</option></select>
<label for="plug">Clavijero: pares separados por espacios (opcional)</label><input id="plug" value="AV BS CG DL FU HZ IN KM OW RX" placeholder="AB CD EF"><p class="muted">Máximo 10 pares; cada letra solo puede aparecer una vez.</p>
<label for="message">Mensaje</label><textarea id="message" rows="4" placeholder="Escribe aquí…"></textarea>
<div class="actions"><button id="run">Cifrar / descifrar</button><button id="reset" type="button">Restablecer posiciones</button></div>
<p id="status" class="muted" role="status">Los espacios y signos se conservan; las letras hacen avanzar los rotores.</p><h2>Resultado</h2><div id="result" aria-live="polite">Aquí aparecerá el resultado.</div><div id="usedConfig" class="config-card" hidden></div><button id="copy" type="button" disabled>Copiar resultado</button></section>
<section class="card"><h2>Tutorial rápido</h2><ol><li>Elige tres rotores diferentes, en orden de izquierda a derecha.</li><li>Define la posición de partida (A–Z) y el anillo (01–26) de cada uno.</li><li>Opcionalmente, añade pares al clavijero, por ejemplo <code>AB CD EF</code>.</li><li>Escribe el mensaje y pulsa «Cifrar / descifrar». Para descifrar, usa la misma configuración y posición de partida.</li></ol><p>Al pulsar una letra, avanza el rotor derecho; el mecanismo de doble paso puede mover también los rotores central e izquierdo. La señal pasa por el clavijero y los rotores, rebota en el reflector y regresa por los rotores. Así, el mismo proceso permite cifrar y descifrar. Al terminar, las posiciones finales quedan en los selectores y se usan en la siguiente operación. Cámbialas manualmente o pulsa «Restablecer posiciones» antes de empezar de nuevo con otra posición.</p><p class="muted">Recreación histórica para aprender: Enigma no es segura para proteger información actual.</p></section>
</main>
<script>
'use strict';
const ABC='ABCDEFGHIJKLMNOPQRSTUVWXYZ';
const R={I:{w:'EKMFLGDQVZNTOWYHXUSPAIBRCJ',n:'Q'},II:{w:'AJDKSIRUXBLHWTMCQGZNPYFVOE',n:'E'},III:{w:'BDFHJLCPRTXVZNYEIWGAKMUSQO',n:'V'},IV:{w:'ESOVPZJAYQUIRHXLNFTGKDCMWB',n:'J'},V:{w:'VZBRGITYUPSDNHLXAWMJQOFECK',n:'Z'}};
const REF={B:'YRUHQSLDPXNGOKMIEBFZCWVJAT',C:'FVPJIAOYEDRZXWGCTKUQSBNMHL'};
document.querySelector('#rotors').innerHTML=['Izquierdo','Central','Derecho'].map((label,i)=>`<div class="rotor"><strong>${label}</strong><label for="type${i}">Rotor</label><select id="type${i}">${Object.keys(R).map(x=>`<option>${x}</option>`).join('')}</select><label for="pos${i}">Posición</label><select id="pos${i}">${[...ABC].map(x=>`<option>${x}</option>`).join('')}</select><label for="ring${i}">Anillo (01–26)</label><input id="ring${i}" type="number" min="1" max="26" value="1"></div>`).join('');
['I','II','III'].forEach((x,i)=>document.querySelector(`#type${i}`).value=x);
function plugboard(text){const map=Array.from({length:26},(_,i)=>i),used=new Set(),s=text.trim().toUpperCase();if(!s)return map;const pairs=s.split(/\s+/);if(pairs.length>10||pairs.some(p=>!/^[A-Z]{2}$/.test(p)))throw Error('Introduce pares de dos letras (por ejemplo AB CD), máximo 10.');for(const p of pairs){const a=ABC.indexOf(p[0]),b=ABC.indexOf(p[1]);if(a===b||used.has(a)||used.has(b))throw Error('No repitas letras en los pares del clavijero.');used.add(a);used.add(b);map[a]=b;map[b]=a}return map}
function pass(x,type,ring,pos,reverse=false){const offset=(pos-ring+26)%26,entry=(x+offset)%26,w=R[type].w,y=reverse?w.indexOf(ABC[entry]):ABC.indexOf(w[entry]);return(y-offset+26)%26}
let copyPayload='';
function process(){const status=document.querySelector('#status'),result=document.querySelector('#result'),usedConfig=document.querySelector('#usedConfig'),copy=document.querySelector('#copy');try{const type=[0,1,2].map(i=>document.querySelector(`#type${i}`).value);if(new Set(type).size!==3)throw Error('Selecciona tres rotores distintos.');const ring=[0,1,2].map(i=>Number(document.querySelector(`#ring${i}`).value)-1);if(ring.some(x=>!Number.isInteger(x)||x<0||x>25))throw Error('Los anillos deben ser números del 1 al 26.');const pos=[0,1,2].map(i=>ABC.indexOf(document.querySelector(`#pos${i}`).value)),startPos=[...pos],plugText=document.querySelector('#plug').value.trim().toUpperCase(),plug=plugboard(plugText),reflectorName=document.querySelector('#reflector').value,reflector=REF[reflectorName];let output='';for(const ch of document.querySelector('#message').value.toUpperCase()){let x=ABC.indexOf(ch);if(x<0){output+=ch;continue}const middle=pos[1]===ABC.indexOf(R[type[1]].n),right=pos[2]===ABC.indexOf(R[type[2]].n);if(middle)pos[0]=(pos[0]+1)%26;if(middle||right)pos[1]=(pos[1]+1)%26;pos[2]=(pos[2]+1)%26;x=plug[x];for(let i=2;i>=0;i--)x=pass(x,type[i],ring[i],pos[i]);x=ABC.indexOf(reflector[x]);for(let i=0;i<3;i++)x=pass(x,type[i],ring[i],pos[i],true);output+=ABC[plug[x]]}pos.forEach((x,i)=>document.querySelector(`#pos${i}`).value=ABC[x]);const answer=output||'(sin letras para procesar)',config=`Rotores: ${type.join(' · ')} | Posición inicial: ${startPos.map(x=>ABC[x]).join(' · ')} | Anillos: ${ring.map(x=>String(x+1).padStart(2,'0')).join(' · ')} | Reflector: ${reflectorName} | Clavijero: ${plugText||'ninguno'}`;result.textContent=answer;usedConfig.replaceChildren();const heading=document.createElement('strong');heading.textContent='⚙ Configuración utilizada';const details=document.createElement('p');details.textContent=`${type.join(' · ')}  |  Posición inicial ${startPos.map(x=>ABC[x]).join(' · ')}  |  Anillos ${ring.map(x=>String(x+1).padStart(2,'0')).join(' · ')}  |  Reflector ${reflectorName}  |  Clavijero ${plugText||'ninguno'}`;usedConfig.append(heading,details);usedConfig.hidden=false;copyPayload=answer;copy.disabled=false;status.textContent=`Listo. Posiciones finales: ${pos.map(x=>ABC[x]).join(' · ')}. Se mantienen para la siguiente operación.`}catch(e){result.textContent='';usedConfig.hidden=true;usedConfig.replaceChildren();copyPayload='';copy.disabled=true;status.textContent=e.message}}
document.querySelector('#run').addEventListener('click',process);
document.querySelector('#copy').addEventListener('click',async()=>{const status=document.querySelector('#status');try{await navigator.clipboard.writeText(copyPayload);status.textContent='Resultado copiado.'}catch{status.textContent='No se pudo acceder al portapapeles. Comprueba los permisos del navegador.'}});
document.querySelector('#reset').addEventListener('click',()=>{[0,1,2].forEach(i=>document.querySelector(`#pos${i}`).value='A');document.querySelector('#status').textContent='Posiciones restablecidas a AAA.'});
</script></body></html>
